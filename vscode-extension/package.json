{
  "name": "contextdoc",
  "displayName": "ContextDoc",
  "description": "Run conceptual tests and detect .ctx drift directly in VS Code",
  "version": "0.1.2",
  "publisher": "Mauto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mauto82/contextdoc"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ctx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextdoc.runTests",
        "title": "ContextDoc: Run Tests"
      },
      {
        "command": "contextdoc.runTestsOnFile",
        "title": "ContextDoc: Run Tests on This File"
      },
      {
        "command": "contextdoc.checkDrift",
        "title": "ContextDoc: Check Drift"
      },
      {
        "command": "contextdoc.setup",
        "title": "ContextDoc: Setup LLM Provider"
      },
      {
        "command": "contextdoc.clearCache",
        "title": "ContextDoc: Clear Test Results Cache"
      }
    ],
    "configuration": {
      "title": "ContextDoc",
      "properties": {
        "contextdoc.model": {
          "type": "string",
          "default": "",
          "description": "Model for conceptual tests, e.g. ollama/gemma4:cloud, ollama/gemma4:e2b, claude-haiku-5-5. Set it with \"ContextDoc: Setup LLM Provider\". Empty: the external ctx-run CLI is used, if installed."
        },
        "contextdoc.ctxRunPath": {
          "type": "string",
          "default": "ctx-run",
          "description": "Path to the ctx-run executable, used only when no model is configured."
        },
        "contextdoc.watchEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Check drift on save and when the workspace opens (built in, no ctx-watch needed)."
        },
        "contextdoc.timeout": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "description": "Seconds to wait for each LLM answer before giving up on that scenario."
        },
        "contextdoc.confirmRuns": {
          "type": "boolean",
          "default": true,
          "description": "Before running the whole workspace (or with a model that is heavy for this machine), show how many LLM calls the run will make and ask to confirm."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextdoc",
          "title": "ContextDoc",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "contextdoc": [
        {
          "id": "contextdoc.testResults",
          "name": "Test Results"
        }
      ]
    },
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".ctx"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node -e \"const fs=require('fs'); fs.copyFileSync('../spec/runner/runner-spec.json', 'out/runner-spec.json'); fs.copyFileSync('../spec/lint/lint-spec.json', 'out/lint-spec.json')\"",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test:smoke": "node test/smoke/run.js",
    "test:unit": "npm run compile && node --test test/unit/*.test.js"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
